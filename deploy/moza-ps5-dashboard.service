[Unit]
Description=MOZA PS5 Pit Control dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/moza-ps5-current
ExecStart=%h/moza-ps5-current/.venv/bin/python -u %h/moza-ps5-current/dashboard/server.py --root %h/moza-ps5-current --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
